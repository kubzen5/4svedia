# Base URL and key issued for hub.ag3nts.org.
AGENTHUB_API_URL=https://hub.ag3nts.org/
AGENTHUB_API_KEY=your_api_key_here

# Optional overrides for the findhim lookup contract and proximity threshold.
FINDHIM_LOOKUP_ENDPOINT=api/people/locations
FINDHIM_MAX_DISTANCE_KM=10

# Required only when refreshing the S01E01 candidate list.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_model_name_here
