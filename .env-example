# Base URL and key issued for hub.ag3nts.org.
AGENTHUB_API_URL=https://hub.ag3nts.org/
AGENTHUB_API_KEY=your_api_key_here

# Optional proximity threshold for matching sightings to power plants.
FINDHIM_MAX_DISTANCE_KM=10

# Required only when refreshing the S01E01 candidate list.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_model_name_here

# S01E03 local HTTP proxy.
PROXY_HOST=127.0.0.1
PROXY_PORT=3000
# Optional: leave empty to discover the URL from a running ngrok agent.
PROXY_PUBLIC_URL=

# S03E04 product search tool. Public URL may be left empty for ngrok discovery.
NEGOTIATIONS_HOST=127.0.0.1
NEGOTIATIONS_PORT=3000
NEGOTIATIONS_PUBLIC_URL=
